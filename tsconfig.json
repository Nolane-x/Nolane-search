{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "vitest/globals",
      "@cloudflare/workers-types/experimental"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
